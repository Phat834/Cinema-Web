@model CinemaManagement.ViewModel.TheaterMoviesViewModel
@{
    ViewData["Title"] = "Quản lý phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Theaters = ViewBag.Theaters ?? new List<CinemaManagement.Models.Theater>();
    ViewBag.Genres = ViewBag.Genres ?? new List<CinemaManagement.Models.Genre>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container-cinema section">

    @if (Model.IsFiltered)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4" style="background: oklch(var(--state-info) / 0.15); color: var(--state-info); border: 1px solid oklch(var(--state-info) / 0.3);">
            <p class="mb-0">Đang lọc theo: <strong>@Model.TheaterName</strong></p>
            <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Index", "Manager")">
                <i class="bi bi-x-circle"></i> Xóa bộ lọc
            </a>
        </div>
    }

    <a class="btn btn-primary mb-4 d-inline-flex align-items-center" href="@Url.Action("Create", "Manager")">
        <i class="bi bi-plus-circle me-2"></i> Thêm phim mới
    </a>

    <div class="movie-grid" style="grid-template-columns: repeat(1, 1fr); gap: var(--gap-inline) var(--gap-stack);">
        @foreach (var movie in Model.Movies)
        {
            var isHidden = !movie.IsActive;
            <div class="card card-interactive @(isHidden ? "opacity-50 grayscale" : "")" style="overflow: hidden;">
                <img loading="lazy" src="@movie.PosterUrl" class="card-img-top" style="height: 240px; object-fit: cover;" alt="@movie.Title" />
                <div class="card-body">
                    <h5 class="card-title text-center mb-2">
                        @movie.Title
                        @if (isHidden)
                        {
                            <span class="badge badge-status coming-soon">Đã ẩn</span>
                        }
                    </h5>
                    <p class="card-text small text-truncate">@movie.Description</p>
                    <p class="card-text small"><strong>Thời lượng:</strong> @movie.Duration phút</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center" style="background: var(--surface-hover); border-top: 1px solid var(--color-border-0);">
                    <a class="btn btn-info btn-sm" href="@Url.Action("Details", "Manager", new { id = movie.MovieId })"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("Edit", "Manager", new { id = movie.MovieId })"><i class="bi bi-pencil"></i></a>
                    @if (movie.IsActive)
                    {
                        <form asp-action="Hide" method="post">
                            <input type="hidden" name="id" value="@movie.MovieId" />
                            <button class="btn btn-warning btn-sm"><i class="bi bi-eye-slash"></i> Ẩn</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Show" method="post">
                            <input type="hidden" name="id" value="@movie.MovieId" />
                            <button class="btn btn-success btn-sm"><i class="bi bi-eye"></i> Hiện</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    @if (!Model.Movies.Any())
    {
        <div class="alert alert-warning text-center" style="background: oklch(var(--state-warning) / 0.15); color: var(--state-warning); border: 1px solid oklch(var(--state-warning) / 0.3);">
            Không có phim nào được tìm thấy.
        </div>
    }
</div>

<style>
    .opacity-50 { opacity: 0.5; }
    .grayscale { filter: grayscale(100%); }
    .card-interactive:hover .card-img-top { transform: scale(1.05); }
</style>
