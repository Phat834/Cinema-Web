@{
    ViewData["Title"] = "Soát vé QR";
}

<style>
    body {
        background-color: #0f0f0f;
        color: #e5e5e5;
        font-family: system-ui, -apple-system, BlinkMacSystemFont;
    }

    .scan-wrapper {
        max-width: 520px;
        margin: 80px auto;
        padding: 30px;
        background: #181818;
        border-radius: 16px;
        box-shadow: 0 0 40px rgba(0,0,0,.6);
    }

    #reader {
        width: 100%;
        margin-top: 20px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #333;
        display: none;
    }

    .btn-main {
        background-color: #e50914;
        border: none;
        font-weight: 600;
        padding: 12px;
    }

        .btn-main:hover {
            background-color: #b20710;
        }

    .order-box {
        background: #111;
        border: 1px solid #333;
        padding: 12px;
        border-radius: 8px;
        margin-top: 15px;
        text-align: center;
        font-size: 15px;
        letter-spacing: .5px;
        display: none;
    }

    /* Print styles - chỉ in khung kết quả soát vé */
    @@media print {
        body * {
            visibility: hidden;
        }
        #ticketResultCard, #ticketResultCard * {
            visibility: visible;
        }
        #ticketResultCard {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: white !important;
            color: black !important;
            padding: 20px;
        }
        .no-print, .modal-header, .btn-close, .btn {
            display: none !important;
        }
    }
</style>

<div class="scan-wrapper text-center">
    <h4 class="mb-4">Soát vé bằng QR</h4>

    <button class="btn btn-main w-100" onclick="startScan()">
        Bắt đầu quét
    </button>

    <div class="mt-3">
        <button type="button" class="btn btn-outline-secondary w-100" onclick="document.getElementById('fileInput').click()">
            📁 Tải ảnh QR lên
        </button>
        <input type="file" id="fileInput" accept="image/*" style="display:none" onchange="handleFileSelect(event)" />
    </div>

    <div class="mt-3">
        <label class="form-label text-secondary">Hoặc nhập mã vé thủ công:</label>
        <div class="input-group">
            <input type="text" id="manualOrderId" class="form-control bg-dark text-white border-secondary" placeholder="Ví dụ: ORDER_ABC123" />
            <button class="btn btn-main" type="button" onclick="checkManualOrder()">Xác nhận vé</button>
        </div>
    </div>

    <div id="rawBox" class="mt-3 p-2 border rounded bg-dark text-white" style="display:none">
        <div class="fw-bold mb-1">Dữ liệu QR đọc được:</div>
        <div id="rawQrText" style="word-break: break-all; color:#ffc107"></div>
    </div>

    <div id="orderBox" class="mt-3 p-2 border rounded bg-dark text-white" style="display:none">
        <div class="fw-bold mb-1">OrderId:</div>
        <div id="orderIdText" style="color:#0dcaf0"></div>
    </div>

    <div id="errorBox" class="alert alert-danger mt-3 d-none"></div>

    <div id="orderBox" class="order-box">
        <div class="text-secondary mb-1">Mã đơn</div>
        <strong id="orderIdText"></strong>
    </div>

    <div id="reader"></div>
</div>

<!-- MODAL -->
<div class="modal fade" id="resultModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Thông tin vé</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/html5-qrcode"></script>

@section Scripts {
    <script>
        let qrScanner;

        function showError(msg) {
            const box = document.getElementById("errorBox");
            box.innerText = msg;
            box.classList.remove("d-none");
        }

        function clearError() {
            document.getElementById("errorBox").classList.add("d-none");
        }

        async function startScan() {
            clearError();

            document.getElementById("rawBox").style.display = "none";
            document.getElementById("orderBox").style.display = "none";

            try {
                await navigator.mediaDevices.getUserMedia({ video: true });
            } catch {
                showError("Camera bị từ chối. Vui lòng cho phép camera.");
                return;
            }

            Html5Qrcode.getCameras().then(devices => {
                if (!devices.length) {
                    showError("Không tìm thấy camera.");
                    return;
                }

                document.getElementById("reader").style.display = "block";

                qrScanner = new Html5Qrcode("reader");
                qrScanner.start(
                    devices[0].id,
                    { fps: 10, qrbox: 260 },
                    rawText => {

                        // 👉 HIỂN THỊ RAW DATA
                        document.getElementById("rawQrText").innerText = rawText;
                        document.getElementById("rawBox").style.display = "block";

                        // 👉 CHUẨN HÓA (CỰC QUAN TRỌNG)
                        let text = normalizeOrderId(rawText)
                            .replace(/\r?\n/g, "")
                            .replace(/\s+/g, "");

                        // 👉 TRƯỜNG HỢP QR LÀ URL
                        if (text.includes("/")) {
                            text = text.substring(text.lastIndexOf("/") + 1);
                        }

                        const regex = /^ORDER_[a-zA-Z0-9]+$/;

                        if (!regex.test(text)) {
                            showError("QR không chứa mã vé hợp lệ.");
                            qrScanner.stop();
                            return;
                        }

                        // 👉 HIỂN THỊ ORDER ID
                        document.getElementById("orderIdText").innerText = text;
                        document.getElementById("orderBox").style.display = "block";

                        qrScanner.stop();
                        ajaxCheck(text);
                    }
                );
            });
        }

        function ajaxCheck(orderId) {
            fetch('/TicketScan/AjaxCheck', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderId)
            })
            .then(r => {
                if (!r.ok) throw "error";
                return r.json();
            })
            .then(res => showResult(res))
            .catch(() => showError("Lỗi kết nối server."));
        }

function showResult(res) {
            let html = "";

            if (!res.success) {
                html = `<div class="text-danger">${res.message}</div>`;
            } else {
                html += `<div id="ticketResultCard">`;
                res.tickets.forEach(t => {
                    html += `
                        <div class="border-bottom border-secondary pb-2 mb-2">
                            <div><b>Phim:</b> ${t.movie}</div>
                            <div><b>Rạp:</b> ${t.theater}</div>
                            <div><b>Phòng:</b> ${t.room}</div>
                            <div><b>Ghế:</b> ${t.seat}</div>
                            <div><b>Suất:</b> ${t.time}</div>
                            <div><b>Thanh toán:</b> ${t.payment}</div>
                        </div>`;
                });
                html += `</div>`;
            }

            // Thêm nút in vé khi soát thành công
            if (res.success) {
                html += `
                    <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
                        <button type="button" id="btnPrintStub" class="btn btn-primary">
                            <i class="fas fa-print me-2"></i>In cuống vé
                        </button>
                    </div>`;
            }

            document.getElementById("modalBody").innerHTML = html;
            const modal = new bootstrap.Modal(document.getElementById("resultModal"));
            modal.show();

            // Gán sự kiện cho nút in vé (tránh inline onclick gây lỗi syntax)
            document.getElementById('btnPrintStub')?.addEventListener('click', () => {
                window.print();
            });
        }

        // Chuẩn hóa OrderId: bỏ tiền tố "OrderId=" nếu có
        function normalizeOrderId(text) {
            const prefix = "orderid=";
            const lower = text.trim().toLowerCase();
            if (lower.startsWith(prefix)) {
                return text.trim().substring(prefix.length);
            }
            return text.trim();
        }

        async function handleFileSelect(event) {
            clearError();
            const file = event.target.files?.[0];
            if (!file) return;

            // Nếu camera đang quét, dừng lại trước
            if (qrScanner) {
                try {
                    await qrScanner.stop();
                } catch (e) {
                    console.warn("Stop scanner failed:", e);
                }
            }

            try {
                const scanner = new Html5Qrcode("reader");
                // Dùng scanFile với đối tượng File trực tiếp (không phải data URL)
                const rawText = await scanner.scanFile(file, true);
                processRawText(rawText);
            } catch (err) {
                showError("Không đọc được mã QR từ ảnh.");
            } finally {
                // Reset để cho phép chọn lại cùng một file
                event.target.value = "";
            }
        }

        function checkManualOrder() {
            clearError();
            const orderId = document.getElementById("manualOrderId").value.trim();
            if (!orderId) {
                showError("Vui lòng nhập mã vé.");
                return;
            }
            processRawText(orderId);
        }

        function processRawText(rawText) {
            document.getElementById("rawQrText").innerText = rawText;
            document.getElementById("rawBox").style.display = "block";

            let text = normalizeOrderId(rawText)
                .replace(/\r?\n/g, "")
                .replace(/\s+/g, "");

            if (text.includes("/")) {
                text = text.substring(text.lastIndexOf("/") + 1);
            }

            const regex = /^ORDER_[a-zA-Z0-9]+$/;

            if (!regex.test(text)) {
                showError("QR không chứa mã vé hợp lệ.");
                return;
            }

            document.getElementById("orderIdText").innerText = text;
            document.getElementById("orderBox").style.display = "block";

            ajaxCheck(text);
        }
    </script>
}



