@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.UserName ?? "User";
    var roles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var genres = ViewBag.Genres as List<CinemaManagement.Models.Genre> ?? new();
}

<!DOCTYPE html>
<html lang="vi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Management</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Design System CSS -->
    <link rel="stylesheet" href="~/css/cinema-design-system.css" />

    <!-- FontAwesome (local) -->
    <link rel="stylesheet" href="~/lib/fontawesome/all.min.css" />
    <!-- Flatpickr (local) -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

    @RenderSection("Styles", required: false)
    <style>
        .form-floating {
            display: flex !important;
            flex-direction: column !important;
            position: relative !important;
            margin-bottom: 1.1rem !important;
        }
        .form-floating > label {
            order: -1 !important;
            position: static !important;
            transform: none !important;
            width: auto !important;
            height: auto !important;
            padding: 0 0 6px 2px !important;
            margin: 0 !important;
            background: transparent !important;
            background-color: transparent !important;
            color: #e5e7eb !important;
            font-size: 0.9rem !important;
            font-weight: 500 !important;
            line-height: 1.4 !important;
            opacity: 1 !important;
            pointer-events: auto !important;
            box-shadow: none !important;
            z-index: 1 !important;
        }
        .form-floating > .form-control,
        .form-floating > .form-select {
            order: 1 !important;
            padding: 0.65rem 0.9rem !important;
            height: 46px !important;
            min-height: 46px !important;
            line-height: 1.5 !important;
            background-color: #111827 !important;
            color: #ffffff !important;
            border: 1px solid #374151 !important;
            border-radius: 8px !important;
        }
        .form-floating > .form-control::placeholder {
            color: #6b7280 !important;
            opacity: 1 !important;
        }
        .form-floating > span.text-danger {
            order: 2 !important;
            margin-top: 4px !important;
            font-size: 0.85rem !important;
        }
    </style>
</head>
<body>
    <!-- Skip Link -->
    <a href="#main-content" class="sr-only focus-ring" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
        Chuyển đến nội dung chính
    </a>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark" id="mainNavbar" role="navigation" aria-label="Điều hướng chính">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Movies" asp-action="Index" aria-label="Cinema Management - Trang chủ">
                <i class="fas fa-film" aria-hidden="true"></i>
                <span>Cinema Management</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto flex-row align-items-center gap-2" role="menubar">
                    <li class="nav-item" role="none">
                        <a class="nav-link" role="menuitem" asp-area="" asp-controller="Movies" asp-action="Index">Trang Chủ</a>
                    </li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Employee"))
                    {
                        <li class="nav-item dropdown" role="none">
                            <a class="nav-link dropdown-toggle" href="#" id="managementDropdown" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">Quản Lý</a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="managementDropdown" role="menu">
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Manager" asp-action="Index">Quản lý phim</a></li>
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Theater" asp-action="Index">Quản lý rạp</a></li>
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Genre" asp-action="Index">Quản lý thể loại</a></li>
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Combo" asp-action="Index">Quản lý combo</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Users" asp-action="Index">Quản lý người dùng</a></li>
                                    <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Admin" asp-action="RevenueStats">Thống kê doanh thu</a></li>
                                }
                            </ul>
                        </li>
                    }

                    @if (!User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown me-1" role="none">
                            <a class="nav-link dropdown-toggle" href="#" id="cinemaDropdown" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">Rạp Chiếu</a>
                            @await Component.InvokeAsync("TheaterDropdown")
                        </li>
                        <li class="nav-item dropdown" role="none">
                            <a class="nav-link dropdown-toggle" href="#" id="genreDropdown" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">Thể Loại</a>
                            @await Component.InvokeAsync("GenreDropdown")
                        </li>
                        <li class="nav-item dropdown" role="none">
                            <a class="nav-link dropdown-toggle" href="#" id="moviesDropdown" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">Phim</a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="moviesDropdown" role="menu">
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Movies" asp-action="NowShowing">Phim đang chiếu</a></li>
                                <li><a class="dropdown-item" role="menuitem" asp-area="" asp-controller="Movies" asp-action="ComingSoon">Phim sắp chiếu</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item" role="none">
                            <a class="btn btn-primary btn-pill" asp-area="" asp-controller="TicketScan" asp-action="Scan" role="button">
                                <i class="fas fa-qrcode" aria-hidden="true"></i> Soát vé
                            </a>
                        </li>
                    }

                    <li class="nav-item" role="none">
                        <form method="get" action="@Url.Action("Index", "Movies")" class="d-flex align-items-center" role="search" aria-label="Tìm kiếm phim">
                            <div class="position-relative">
                                <i class="fas fa-search position-absolute" style="left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;"></i>
                                <input type="text" class="form-control ps-5" name="searchQuery" id="voiceSearchInput" placeholder="Tìm kiếm phim..." value="@ViewData["SearchQuery"]" autocomplete="off" aria-label="Tìm kiếm phim" style="background: var(--surface-elevated); border: 1px solid var(--color-border-0); color: var(--text-primary);" />
                            </div>
                            <button class="btn btn-ghost ms-2" type="submit" aria-label="Tìm kiếm"><i class="fas fa-search" aria-hidden="true"></i></button>
                            <button class="btn btn-ghost" type="button" id="voiceSearchBtn" aria-label="Tìm kiếm bằng giọng nói"><i class="fas fa-microphone" aria-hidden="true"></i></button>
                        </form>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item dropdown" role="none">
                            <a class="nav-link p-0 dropdown-toggle" href="#" id="userDropdown" role="menuitem" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="btn btn-ghost d-flex align-items-center gap-2 px-3"><i class="fas fa-user" aria-hidden="true"></i> @currentUserName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown" role="menu">
                                <li><a class="dropdown-item" role="menuitem" asp-area="Identity" asp-page="/Account/Manage/Index">Quản lý hồ sơ</a></li>
                                @foreach (var role in roles)
                                {
                                    <li><span class="dropdown-item text-muted" style="cursor:default;">Role: @role</span></li>
                                }
                                <li><hr class="dropdown-divider" style="border-color: var(--color-border-0); margin: var(--space-2) 0;"></li>
                                <li class="d-flex justify-content-center">
<form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                    <button type="submit" class="btn btn-danger btn-pill w-100">Đăng xuất</button>
                                </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item" role="none"><a class="nav-link" role="menuitem" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
                        <li class="nav-item" role="none"><a class="btn btn-primary btn-pill" role="menuitem" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="content-wrapper" style="flex: 1; padding-top: 72px;">
        <main id="main-content" class="container-cinema" role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer-cinema" role="contentinfo">
        <div class="container-cinema text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year - Cinema Management</p>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Navbar scroll shadow -->
    <script>
        (function() {
            const navbar = document.getElementById('mainNavbar');
            if (!navbar) return;
            const onScroll = () => {
                navbar.classList.toggle('scrolled', window.scrollY > 8);
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
        })();
    </script>

    <!-- Voice Search -->
    <script>
        document.getElementById('voiceSearchBtn')?.addEventListener('click', () => {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Trình duyệt của bạn không hỗ trợ voice search!");
                return;
            }

            const input = document.getElementById('voiceSearchInput');
            input.value = '';

            const recognition = new SpeechRecognition();
            recognition.lang = 'vi-VN';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            recognition.start();

            recognition.onstart = () => console.log("Đang lắng nghe giọng nói...");

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                console.log("Bạn vừa nói: ", transcript);
                input.value = transcript;
                input.form.submit();

                setTimeout(() => { input.value = ''; }, 5000);
            };

            recognition.onerror = (event) => {
                console.error("Lỗi voice recognition: ", event.error);
                alert("Lỗi nhận diện giọng nói: " + event.error);
            };

            recognition.onend = () => console.log("Kết thúc nhận diện giọng nói.");
        });
    </script>

    <!-- Genre Filter -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".genre-filter").forEach(function (el) {
                el.addEventListener("click", function (e) {
                    e.preventDefault();
                    const genreId = el.getAttribute("data-genre-id");
                    const searchParams = new URLSearchParams(window.location.search);
                    searchParams.set("genreId", genreId);
                    window.location.href = "/Movies/Index?" + searchParams.toString();
                });
            });
        });
    </script>

    @if (!Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment())
    {
        <!-- Chatbox (Production only) -->
        <script src="https://app.tudongchat.com/js/chatbox.js"></script>
        <script>
            const tudong_chatbox = new TuDongChat('-hNaUoaY4v9Wfxc1hd58y')
            tudong_chatbox.initial()
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>