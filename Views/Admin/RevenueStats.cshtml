@model CinemaManagement.ViewModels.RevenueStatsViewModel
@{
    ViewData["Title"] = "Thống kê doanh thu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/cinema-design-system.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container-cinema section">
    <h2 class="display-3 mb-6">🎬 Thống kê doanh thu</h2>

    <form method="post" class="mb-6 gap-4 flex flex-wrap items-end">
        <div>
            <label class="block label">Từ</label>
            <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="block label">Đến</label>
            <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div>
            <label class="block label">Phương thức</label>
            <select name="paymentMethod" class="form-select">
                <option value="All" selected="@(Model.PaymentMethod == "All")">Tất cả</option>
                <option value="Momo" selected="@(Model.PaymentMethod == "Momo")">Momo</option>
                <option value="Cash" selected="@(Model.PaymentMethod == "Cash")">Tiền mặt</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Lọc</button>
        </div>
    </form>

    <div class="mb-8 gap-6" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
        <div class="card p-4 shadow-1">
            <p class="label text-success">💰 Tổng doanh thu:</p>
            <p class="display-3">@Model.TotalRevenue.ToString("C")</p>
        </div>
        <div class="card p-4 shadow-1">
            <p class="label text-warning">🎟 Số vé bán ra:</p>
            <p class="display-3">@Model.TotalTickets</p>
        </div>
    </div>

    <!-- Doanh thu theo phim -->
    <h3 class="heading-3 mb-4 text-brand">Doanh thu theo phim</h3>
    <div class="gap-6 mb-8" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        @foreach(var item in Model.ByMovie)
        {
            <div class="card p-4 shadow-1 card-interactive">
                <p class="heading-4">@item.MovieTitle</p>
                <p>🎟 Số vé: <span class="mono font-bold">@item.TicketsSold</span></p>
                <p>💰 Doanh thu: <span class="mono font-bold text-brand">@item.Revenue.ToString("C")</span></p>
            </div>
        }
    </div>

    <!-- Doanh thu theo rạp -->
    <h3 class="heading-3 mb-4 text-brand">Doanh thu theo rạp</h3>
    <div class="gap-6 mb-8" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        @foreach(var item in Model.ByTheater)
        {
            <div class="card p-4 shadow-1 card-interactive">
                <p class="heading-4">@item.TheaterName</p>
                <p>🎟 Số vé: <span class="mono font-bold">@item.TicketsSold</span></p>
                <p>💰 Doanh thu: <span class="mono font-bold text-brand">@item.Revenue.ToString("C")</span></p>
            </div>
        }
    </div>

    <!-- Doanh thu theo suất chiếu -->
    <h3 class="heading-3 mb-4 text-brand">Doanh thu theo suất chiếu</h3>
    <div class="gap-6" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
        @foreach(var item in Model.ByShowtime)
        {
            <div class="card p-4 shadow-1 card-interactive">
                <p class="heading-4">@item.MovieTitle</p>
                <p>🏢 Rạp: @item.TheaterName</p>
                <p>🕒 Suất chiếu: @item.Showtime.ToString("dd/MM/yyyy HH:mm")</p>
                <p>🎟 Số vé: <span class="mono font-bold">@item.TicketsSold</span></p>
                <p>💰 Doanh thu: <span class="mono font-bold text-brand">@item.Revenue.ToString("C")</span></p>
            </div>
        }
    </div>
</div>

<style>
    /* Hiệu ứng fade-in khi tải */
    .animate-fade-in {
        animation: fadeIn 0.5s ease-in;
    }
</style>
