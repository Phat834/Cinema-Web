@using CinemaManagement.ViewModel
@model TheaterMoviesViewModel

@{
    ViewData["Title"] = "Danh sách phim";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

@section Styles {
    <style>
        .movie-grid {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: var(--gap-inline) var(--gap-stack);
        }

        @@media (min-width: 640px) { .movie-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (min-width: 1024px) { .movie-grid { grid-template-columns: repeat(3, 1fr); } }
        @@media (min-width: 1280px) { .movie-grid { grid-template-columns: repeat(4, 1fr); } }

        /* Tab navigation */
        .tab-nav-cinema {
            display: flex;
            justify-content: center;
            gap: var(--space-3);
            margin-bottom: var(--space-6);
            flex-wrap: wrap;
        }

        .tab-btn-cinema {
            font-family: var(--font-display);
            font-size: var(--text-label);
            font-weight: 600;
            letter-spacing: var(--ls-label);
            padding: var(--space-2) var(--space-5);
            border-radius: var(--radius-full);
            background: var(--surface-elevated);
            border: 1px solid var(--color-border-0);
            color: var(--text-secondary);
            cursor: pointer;
            transition: all var(--duration-2) var(--ease-standard);
            min-height: 44px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
        }

        .tab-btn-cinema:hover {
            background: var(--surface-hover);
            color: var(--text-primary);
            border-color: var(--color-border-1);
            text-decoration: none;
        }

        .tab-btn-cinema.active {
            background: var(--action-primary);
            border-color: var(--action-primary);
            color: var(--text-on-brand);
        }

        .tab-btn-cinema:focus-visible {
            outline: none;
            box-shadow: var(--shadow-focus);
        }

        /* Section header */
        .section-header {
            text-align: center;
            margin-bottom: var(--gap-section);
        }

        .section-header .eyebrow {
            display: inline-block;
            font-family: var(--font-display);
            font-size: var(--text-caption);
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--action-primary);
            margin-bottom: var(--space-2);
        }

        .section-header h2 {
            font-family: var(--font-display);
            font-size: clamp(1.75rem, 3vw, 2.5rem);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--text-primary);
            margin: 0;
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: var(--space-9) var(--space-4);
            color: var(--text-muted);
        }

        .empty-state i { font-size: 4rem; margin-bottom: var(--space-4); opacity: 0.5; }
        .empty-state h3 { font-family: var(--font-display); font-size: var(--text-heading-2); color: var(--text-secondary); margin-bottom: var(--space-2); }
        .empty-state p { font-size: var(--text-body); max-width: 400px; margin-inline: auto; margin-bottom: var(--space-5); }

        /* Filter bar */
        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-3);
            margin-bottom: var(--space-5);
            padding: var(--space-4);
            background: var(--surface-elevated);
            border: 1px solid var(--color-border-0);
            border-radius: var(--radius-lg);
        }

        .filter-group { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
        .filter-label { font-size: var(--text-caption); font-weight: 500; color: var(--text-secondary); white-space: nowrap; }

        .form-select-cinema {
            font-family: var(--font-ui);
            font-size: var(--text-body-sm);
            padding: var(--space-1) var(--space-3);
            padding-right: var(--space-8);
            border: 1px solid var(--color-border-0);
            border-radius: var(--radius-md);
            background: var(--surface-canvas) url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e") no-repeat right var(--space-2) center / 16px 12px;
            appearance: none;
            color: var(--text-primary);
            min-height: 40px;
            cursor: pointer;
        }

        .form-select-cinema:focus {
            outline: none;
            border-color: var(--focus-ring);
            box-shadow: var(--shadow-focus);
        }

        .search-wrapper { flex: 1; min-width: 200px; max-width: 360px; }
        .search-input-cinema {
            width: 100%;
            font-family: var(--font-ui);
            font-size: var(--text-body-sm);
            padding: var(--space-2) var(--space-4);
            padding-left: var(--space-10);
            border: 1px solid var(--color-border-0);
            border-radius: var(--radius-full);
            background: var(--surface-canvas);
            color: var(--text-primary);
            transition: border-color var(--duration-1) var(--ease-standard), box-shadow var(--duration-1) var(--ease-standard);
        }

        .search-input-cinema::placeholder { color: var(--text-muted); }
        .search-input-cinema:focus {
            outline: none;
            border-color: var(--focus-ring);
            box-shadow: var(--shadow-focus);
        }

        .search-icon { position: absolute; left: var(--space-3); top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
    </style>
}

<!-- NÚT CHUYỂN PHIM ĐANG CHIẾU / SẮP CHIẾU -->
<nav class="tab-nav-cinema" aria-label="Chọn trạng thái phim" role="tablist">
    <a href="@Url.Action("NowShowing", "Movies")"
       class="tab-btn-cinema @(currentAction == "NowShowing" ? "active" : "")"
       role="tab"
       aria-selected="@(currentAction == "NowShowing")"
       aria-controls="movies-panel">
        <i class="fas fa-play" aria-hidden="true"></i> Phim đang chiếu
    </a>

    <a href="@Url.Action("ComingSoon", "Movies")"
       class="tab-btn-cinema @(currentAction == "ComingSoon" ? "active" : "")"
       role="tab"
       aria-selected="@(currentAction == "ComingSoon")"
       aria-controls="movies-panel">
        <i class="fas fa-clock" aria-hidden="true"></i> Phim sắp chiếu
    </a>
</nav>

<!-- TIÊU ĐỀ -->
<div class="section-header">
    <span class="eyebrow">@(currentAction == "NowShowing" ? "Đang công chiếu" : "Sắp ra mắt")</span>
    <h2>@(currentAction == "NowShowing" ? "🎬 PHIM ĐANG CHIẾU" : "🎭 PHIM SẮP CHIẾU")</h2>
</div>

<!-- FILTER BAR -->
<div class="filter-bar" role="search" aria-label="Bộ lọc phim">
    <div class="filter-group">
        <span class="filter-label">Sắp xếp:</span>
        <select id="sortBy" class="form-select-cinema" aria-label="Sắp xếp theo">
            <option value="">Mặc định</option>
            <option value="rating_desc">Đánh giá cao nhất</option>
            <option value="rating_asc">Đánh giá thấp nhất</option>
            <option value="title_asc">Tên A-Z</option>
            <option value="title_desc">Tên Z-A</option>
            <option value="release_desc">Mới nhất</option>
            <option value="release_asc">Cũ nhất</option>
        </select>
    </div>

    <div class="search-wrapper" style="position: relative; flex: 1; min-width: 200px; max-width: 360px;">
        <i class="fas fa-search search-icon" aria-hidden="true"></i>
        <input type="text" class="search-input-cinema" id="voiceSearchInput" name="searchQuery" placeholder="Tìm kiếm phim..." value="@ViewData["SearchQuery"]" autocomplete="off" aria-label="Tìm kiếm phim" />
    </div>

    <div class="filter-group">
        <input type="hidden" name="theaterId" id="theaterId" value="@ViewData["TheaterId"]" />
        <input type="hidden" name="time" id="time" value="@ViewData["Time"]" />
    </div>
</div>

<!-- DANH SÁCH PHIM -->
<div class="row" style="display: contents;">
    <div class="movie-grid" id="moviesContainer" role="list">
        @await Html.PartialAsync("_MovieCardsPartial", Model.Movies)
    </div>
</div>

@if (!Model.Movies.Any())
{
    <div class="empty-state" role="status">
        <i class="fas fa-film" aria-hidden="true"></i>
        <h3>Không có phim nào</h3>
        <p>Vui lòng quay lại sau hoặc chọn danh mục khác.</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary btn-pill">Quay về trang chủ</a>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            function loadMovies() {
                var searchQuery = $('#voiceSearchInput').val();
                var sortBy = $('#sortBy').val();
                var theaterId = $('input[name="theaterId"]').val();
                var time = $('#time').val();
                var action = '@currentAction';

                $.ajax({
                    url: '@Url.Action("FilterAjax", "Movies")',
                    type: 'GET',
                    data: {
                        searchQuery: searchQuery,
                        sortBy: sortBy,
                        theaterId: theaterId,
                        time: time,
                        action: action
                    },
                    success: function (data) {
                        $('#moviesContainer').html(data);
                    },
                    error: function () {
                        alert('Có lỗi khi tải phim!');
                    }
                });
            }

            // Debounced search
            let searchTimeout;
            $('#voiceSearchInput').on('keyup', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(loadMovies, 300);
            });

            $('#sortBy').on('change', loadMovies);
        });
    </script>
}