@model CinemaManagement.ViewModel.PaymentViewModel

@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-5">
    <h2 class="text-light text-center mb-4">💳 Thanh Toán</h2>

    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card bg-dark text-light mb-4">
                <div class="card-header">
                    <h5>🧾 Tóm Tắt Đơn Hàng</h5>
                </div>
                <div class="card-body">
                    <p>Tiền vé: <span class="float-end">@Model.TicketTotal.ToString("#,##0") VND</span></p>
                    <p>Tiền combo: <span class="float-end">@Model.ComboTotal.ToString("#,##0") VND</span></p>
                    <hr>
                    <p class="fw-bold">Tổng cộng: <span class="float-end text-warning">@Model.GrandTotal.ToString("#,##0") VND</span></p>
                </div>
            </div>

            <div class="card bg-dark text-light mb-4">
                <div class="card-header">
                    <h5>💰 Chọn Phương Thức Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3" id="paymentMethods">
                        <div class="col-6 col-md-3">
                            <button type="button" class="payment-method-btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" data-method="MoMo" onclick="selectPaymentMethod('MoMo')">
                                <svg class="payment-icon mb-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect width="24" height="24" rx="6" fill="#a50064"/>
                                    <path d="M6 16V9.5C6 8.67 6.67 8 7.5 8C8.33 8 9 8.67 9 9.5V16M9 9.8C9.2 8.8 10 8 11.2 8C12.5 8 13.4 8.9 13.4 10.2V16M13.4 10.2C13.6 8.95 14.45 8 15.7 8C17 8 18 9 18 10.3V16" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span class="small fw-medium text-center">Ví MoMo</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button type="button" class="payment-method-btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" data-method="ZaloPay" onclick="selectPaymentMethod('ZaloPay')">
                                <svg class="payment-icon mb-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect width="24" height="24" rx="6" fill="#0068ff"/>
                                    <path d="M7 8.2H17L8.2 15.8H17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                                <span class="small fw-medium text-center">Ví ZaloPay</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button type="button" class="payment-method-btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" data-method="ShopeePay" onclick="selectPaymentMethod('ShopeePay')">
                                <svg class="payment-icon mb-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect width="24" height="24" rx="6" fill="#ee4d2d"/>
                                    <path d="M7 9.2C7 8.54 7.54 8 8.2 8H15.8C16.46 8 17 8.54 17 9.2V15.8C17 16.46 16.46 17 15.8 17H8.2C7.54 17 7 16.46 7 15.8V9.2Z" stroke="white" stroke-width="1.8"/>
                                    <path d="M9.5 8C9.5 6.62 10.62 5.5 12 5.5C13.38 5.5 14.5 6.62 14.5 8" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                                <span class="small fw-medium text-center">Ví ShopeePay</span>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button type="button" class="payment-method-btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" data-method="Cash" onclick="selectPaymentMethod('Cash')">
                                <svg class="payment-icon mb-2" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect width="24" height="24" rx="6" fill="#10b981"/>
                                    <rect x="5.5" y="7.5" width="13" height="9" rx="2" stroke="white" stroke-width="1.8"/>
                                    <circle cx="12" cy="12" r="2" stroke="white" stroke-width="1.8"/>
                                </svg>
                                <span class="small fw-medium text-center">Tiền mặt tại quầy</span>
                            </button>
                        </div>
                    </div>

                    <input type="hidden" id="selectedMethodInput" name="method" value="MoMo" />
                    <div id="selectedMethodInfo" class="mt-3 d-none">
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle me-2"></i>Đã chọn: <strong id="selectedMethodName"></strong>
                        </div>
                    </div>

                    <button type="button" id="confirmPaymentBtn" class="btn btn-primary btn-lg w-100 mt-3" disabled onclick="submitPayment()">
                        Xác nhận thanh toán
                    </button>

                    <form id="cashPaymentForm" method="post" asp-controller="Booking" asp-action="ConfirmPayment" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                        <input type="hidden" name="method" id="cashMethodInput" value="Cash" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const orderId = '@Model.OrderId';
        let selectedMethod = null;

        const methodLabels = {
            'MoMo': 'Ví MoMo',
            'ZaloPay': 'Ví ZaloPay',
            'ShopeePay': 'Ví ShopeePay',
            'Cash': 'Tiền mặt tại quầy'
        };

        function selectPaymentMethod(method) {
            document.querySelectorAll('.payment-method-btn').forEach(b => b.classList.remove('selected'));
            const btn = document.querySelector('.payment-method-btn[data-method="' + method + '"]');
            if (btn) btn.classList.add('selected');

            selectedMethod = method;
            document.getElementById('selectedMethodInput').value = method;
            document.getElementById('selectedMethodName').textContent = methodLabels[method] || method;
            document.getElementById('selectedMethodInfo').classList.remove('d-none');
            document.getElementById('confirmPaymentBtn').disabled = false;
        }

        function submitPayment() {
            if (!selectedMethod) return;
            if (selectedMethod === 'MoMo' || selectedMethod === 'ZaloPay' || selectedMethod === 'ShopeePay') {
                window.location.href = '/Booking/QRPayment?orderId=' + encodeURIComponent(orderId) + '&method=' + encodeURIComponent(selectedMethod);
                return;
            }
            if (selectedMethod === 'Cash') {
                document.getElementById('cashMethodInput').value = 'Cash';
                document.getElementById('cashPaymentForm').submit();
            }
        }

        // Preselect MoMo for clarity
        selectPaymentMethod('MoMo');
    </script>
}

@section Styles {
    <style>
        .card {
            border: 1px solid #444;
        }

        .payment-method-btn {
            background: #1a1a1a;
            border: 2px solid #333;
            border-radius: 12px;
            color: #f5f5f5;
            transition: all 0.2s ease;
            cursor: pointer;
            min-height: 130px;
        }

        .payment-method-btn:hover {
            border-color: #666;
            background: #222;
            transform: translateY(-2px);
        }

        .payment-method-btn.selected {
            border-color: #0d6efd !important;
            background: rgba(13, 110, 253, 0.15);
            box-shadow: 0 0 0 2px rgba(13, 110, 253, 0.25);
        }

        .payment-icon {
            width: 40px;
            height: 40px;
        }

        @@media (max-width: 576px) {
            .payment-method-btn {
                min-height: 110px;
            }
        }
    </style>
}