@using CinemaManagement.ViewModel
@model PaymentSuccessViewModel

@{
    ViewData["Title"] = "Thanh toán thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-cinema section">
    <div class="card p-5 text-center shadow-3">

        <h2 class="display-3 text-success mb-3">?? Thanh toán thành công!</h2>
        <p class="lead">Du?i dây là thông tin vé c?a b?n:</p>

        <hr class="my-4" />

        @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
        {
            <h4 class="heading-3 mb-3">?? Mã QR vé</h4>
            <img loading="lazy" src="data:image/png;base64,@Model.QrCodeBase64"
                 class="img-fluid mb-4" style="max-width:250px" />
        }

        <h4 class="heading-3 mb-3">?? Chi ti?t vé</h4>

        @if (Model.Tickets != null && Model.Tickets.Any())
        {
            @foreach (var ticket in Model.Tickets)
            {
                <div class="card p-3 mb-3 text-start">
                    <p><strong>Phim:</strong> @ticket.Showtime?.Movie?.Title </p>
                    <p><strong>Thành ph?:</strong> @ticket.Seat?.Room?.Theater?.City</p>
                    <p><strong>R?p:</strong> @ticket.Seat?.Room?.Theater?.Name </p>
                    <p><strong>Phòng:</strong> @ticket.Seat?.Room?.Name </p>
                    <p><strong>Gh?:</strong> @ticket.Seat?.SeatNumber </p>
                    <p><strong>Ngày chi?u:</strong> @(ticket.Showtime?.StartTime.ToString("dd/MM/yyyy") )</p>
                    <p><strong>Gi? chi?u:</strong> @(ticket.Showtime?.StartTime.ToString("HH:mm"))</p>
                    <p><strong>Ngu?i mua:</strong> @ticket.User?.FullName </p>
                    <p><strong>Giá vé:</strong> @ticket.Price.ToString("#,##0")</p>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Không tìm th?y vé.</p>
        }

        <a href="/" class="btn btn-primary btn-pill mt-4 px-5">? Quay l?i trang ch?</a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        .success-box {
            max-width: 600px;
            margin: auto;
            background: var(--surface-elevated);
        }

        body {
            background: var(--surface-canvas);
        }

        .success-icon {
            animation: pop 0.5s ease-in-out;
        }

        @@keyframes pop {
            0% {
                transform: scale(0.8);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }
    </style>
}