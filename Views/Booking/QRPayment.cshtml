@model CinemaManagement.ViewModel.QRPaymentViewModel

@{
    ViewData["Title"] = "Thanh toán QR";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var displayNames = new Dictionary<string, string>
    {
        ["MoMo"] = "Ví MoMo",
        ["ZaloPay"] = "Ví ZaloPay",
        ["ShopeePay"] = "Ví ShopeePay"
    };

    var methodColors = new Dictionary<string, string>
    {
        ["MoMo"] = "#a50064",
        ["ZaloPay"] = "#0068ff",
        ["ShopeePay"] = "#ee4d2d"
    };

    var displayName = displayNames.ContainsKey(Model.PaymentMethod) ? displayNames[Model.PaymentMethod] : Model.PaymentMethod;
    var methodColor = methodColors.ContainsKey(Model.PaymentMethod) ? methodColors[Model.PaymentMethod] : "#ffbe0b";
}

<div class="booking-result-wrapper">
    <div class="qr-card">
        <div class="text-center mb-4">
            <h3 class="mb-1">Thanh toán qua</h3>
            <h4 style="color: @methodColor;" class="mb-3">@displayName</h4>
            <div class="amount-box">
                <span>Tổng số tiền cần trả</span>
                <strong>@Model.Amount.ToString("#,##0") VND</strong>
            </div>
            <p class="text-muted mt-3 mb-0">Mã QR có hiệu lực trong <span id="countdown">@Model.CountdownSeconds</span> giây</p>
        </div>

        <div class="qr-image-wrap">
            @if (!string.IsNullOrEmpty(Model.QrCodeImageUrl))
            {
                <img src="@Model.QrCodeImageUrl"
                     alt="Mã QR thanh toán @displayName"
                     class="qr-image"
                     loading="lazy" />
            }
        </div>

        <form method="post" asp-controller="Booking" asp-action="ConfirmPayment" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.OrderId" />
            <input type="hidden" name="method" value="@Model.PaymentMethod" />
            <button type="submit" id="confirmPaidBtn" class="btn btn-success btn-lg w-100">
                <i class="fas fa-check-circle me-2"></i>Xác nhận đã thanh toán (Demo)
            </button>
            <a href="/Booking/Payment?orderId=@Model.OrderId" class="btn btn-outline-secondary w-100 mt-2">Quay lại chọn phương thức</a>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let countdown = @Model.CountdownSeconds;
        let countdownInterval = null;

        function startCountdown() {
            const countdownEl = document.getElementById('countdown');
            countdownInterval = setInterval(() => {
                countdown--;
                if (countdownEl) countdownEl.textContent = countdown;
                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                    if (countdownEl) countdownEl.textContent = 'Hết hạn';
                    const confirmBtn = document.getElementById('confirmPaidBtn');
                    if (confirmBtn) {
                        confirmBtn.disabled = true;
                        confirmBtn.innerHTML = '<i class="fas fa-times-circle me-2"></i>Mã QR đã hết hạn';
                        confirmBtn.classList.remove('btn-success');
                        confirmBtn.classList.add('btn-secondary');
                    }
                }
            }, 1000);
        }

        startCountdown();
        window.addEventListener('beforeunload', () => {
            if (countdownInterval) clearInterval(countdownInterval);
        });
    </script>
}

@section Styles {
    <style>
        .booking-result-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 75vh;
            padding: 2rem 1rem;
            width: 100%;
        }

        .qr-card {
            width: 100%;
            max-width: 460px;
            background: #1f1f1f;
            color: #f5f5f5;
            border: 1px solid #333;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,.35);
        }

        .amount-box {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 0.9rem 1rem;
        }

        .amount-box strong {
            font-size: 1.4rem;
        }

        .qr-image-wrap {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .qr-image {
            width: 240px;
            height: 240px;
            max-width: 100%;
            background: #fff;
            padding: 10px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            display: block;
        }

        .qr-card .btn {
            width: 100%;
            box-sizing: border-box;
        }

        .btn-success {
            background: linear-gradient(135deg, #00b894, #00cec9);
            border: none;
        }

        .btn-success:hover:not(:disabled) {
            background: linear-gradient(135deg, #00cec9, #00b894);
        }
    </style>
}